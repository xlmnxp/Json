import "Spp";
import "Spp/Ast";
import "Srl/String";
import "Srl/Console";
import "Srl/Array";
import "Srl/Map";
import "Srl/Memory";
import "Srl/Nullable";
import "Apm";
Apm.importPackage("Alusus/Json@0.2");

use Srl;
use Spp;

class Person {
    def name : Nullable[String];
    def tags : Array[Nullable[String]];
    def scores : Map[String, Nullable[String]];
    def data : Map[String, Array[Nullable[String]]];
    def scoresByRound : Array[Map[String, Nullable[String]]];
}

def jsonStr : CharsPtr = "{\"name\": \"Sarmed\", \"tags\": [\"admin\", null], \"scores\": {\"math\": \"A\", \"art\": null}, \"data\": {\"languages\": [\"Alusus\", \"C++\"]}, \"scoresByRound\": [{\"math\": \"A\", \"art\": null}, {\"gym\": \"B\"}]}";

def person : Person();
Json.parse[Person](person, jsonStr);

if person.name.isNull Console.print("name: null\n")
else Console.print("name: %s\n", person.name.value.buf);

def i : Int;
Console.print("tags: ");
for i = 0, i < person.tags.getLength(), ++i {
    if person.tags(i).isNull Console.print("null ")
    else Console.print("%s ", person.tags(i).value.buf);
}
Console.print("\n");

Console.print("scores:\n");
for i = 0, i < person.scores.getLength(), ++i {
    if person.scores.valAt(i).isNull Console.print("  %s: null\n", person.scores.keyAt(i).buf)
    else Console.print("  %s: %s\n", person.scores.keyAt(i).buf, person.scores.valAt(i).value.buf);
}

Console.print("data:\n");
for i = 0, i < person.data.getLength(), ++i {
    Console.print("  %s: ", person.data.keyAt(i).buf);
    def arr : Array[Nullable[String]](person.data.valAt(i));
    def j : Int;
    for j = 0, j < arr.getLength(), ++j {
        if arr(j).isNull Console.print("null ")
        else Console.print("%s ", arr(j).value.buf);
    }
    Console.print("\n");
}

Console.print("scoresByRound:\n");
for i = 0, i < person.scoresByRound.getLength(), ++i {
    Console.print("  round %d: ", i);
    def round : Map[String, Nullable[String]](person.scoresByRound(i));
    def j : Int;
    for j = 0, j < round.getLength(), ++j {
        if round.valAt(j).isNull Console.print("%s=null ", round.keyAt(j).buf)
        else Console.print("%s=%s ", round.keyAt(j).buf, round.valAt(j).value.buf);
    }
    Console.print("\n");
}
