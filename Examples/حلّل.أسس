اشمل "مـتم/طـرفية.أسس"؛
اشمل "مـتم/نـص.أسس"؛
اشمل "مـتم/بـعدم.أسس"؛
اشمل "مـتم/مـصفوفة.أسس"؛
اشمل "مـتم/تـطبيق.أسس"؛
مـحا.اشمل_حزمة("Alusus/Json@0.2"، "جـيسون.أسس")؛

استخدم مـتم؛

صنف شخص {
    عرف الاسم: بـعدم[نـص]؛
    عرف الوسوم: مـصفوفة[بـعدم[نـص]]؛
    عرف الدرجات: تـطبيق[نـص, بـعدم[نـص]]؛
    عرف البيانات: تـطبيق[نـص, مـصفوفة[بـعدم[نـص]]]؛
    عرف الدرجات_بالجولة: مـصفوفة[تـطبيق[نـص, بـعدم[نـص]]]؛
}

عرف نص_جيسون: مـؤشر_محارف = "{\"الاسم\": \"سرمد\", \"الوسوم\": [\"مسؤول\", null], \"الدرجات\": {\"رياضيات\": \"A\", \"فن\": null}, \"البيانات\": {\"اللغات\": [\"الأسس\", \"سي++\"]}, \"الدرجات_بالجولة\": [{\"رياضيات\": \"A\", \"فن\": null}, {\"رياضة\": \"B\"}]}"؛

عرف ش: شخص()؛
جـيسون.حلّل[شخص](ش، نص_جيسون)؛

إذا ش.الاسم.أهو_عدم طـرفية.اطبع("الاسم: عدم\ج")
وإلا طـرفية.اطبع("الاسم: %s\ج"، ش.الاسم.القيمة.صوان)؛

عرف م: صـحيح؛
طـرفية.اطبع("الوسوم: ")؛
لكل م = 0، م < ش.الوسوم.هات_الطول()، ++م {
    إذا ش.الوسوم(م).أهو_عدم طـرفية.اطبع("عدم ")
    وإلا طـرفية.اطبع("%s "، ش.الوسوم(م).القيمة.صوان)؛
}
طـرفية.اطبع("\ج")؛

طـرفية.اطبع("الدرجات:\ج")؛
لكل م = 0، م < ش.الدرجات.هات_الطول()، ++م {
    إذا ش.الدرجات.القيمة_عند(م).أهو_عدم طـرفية.اطبع("  %s: عدم\ج"، ش.الدرجات.المفتاح_عند(م).صوان)
    وإلا طـرفية.اطبع("  %s: %s\ج"، ش.الدرجات.المفتاح_عند(م).صوان، ش.الدرجات.القيمة_عند(م).القيمة.صوان)؛
}

طـرفية.اطبع("البيانات:\ج")؛
لكل م = 0، م < ش.البيانات.هات_الطول()، ++م {
    طـرفية.اطبع("  %s: "، ش.البيانات.المفتاح_عند(م).صوان)؛
    عرف مصفوفة_فرعية: مـصفوفة[بـعدم[نـص]](ش.البيانات.القيمة_عند(م))؛
    عرف ن: صـحيح؛
    لكل ن = 0، ن < مصفوفة_فرعية.هات_الطول()، ++ن {
        إذا مصفوفة_فرعية(ن).أهو_عدم طـرفية.اطبع("عدم ")
        وإلا طـرفية.اطبع("%s "، مصفوفة_فرعية(ن).القيمة.صوان)؛
    }
    طـرفية.اطبع("\ج")؛
}

طـرفية.اطبع("الدرجات_بالجولة:\ج")؛
لكل م = 0، م < ش.الدرجات_بالجولة.هات_الطول()، ++م {
    طـرفية.اطبع("  جولة %d: "، م)؛
    عرف جولة_فرعية: تـطبيق[نـص, بـعدم[نـص]](ش.الدرجات_بالجولة(م))؛
    عرف ن: صـحيح؛
    لكل ن = 0، ن < جولة_فرعية.هات_الطول()، ++ن {
        إذا جولة_فرعية.القيمة_عند(ن).أهو_عدم طـرفية.اطبع("%s=عدم "، جولة_فرعية.المفتاح_عند(ن).صوان)
        وإلا طـرفية.اطبع("%s=%s "، جولة_فرعية.المفتاح_عند(ن).صوان، جولة_فرعية.القيمة_عند(ن).القيمة.صوان)؛
    }
    طـرفية.اطبع("\ج")؛
}
